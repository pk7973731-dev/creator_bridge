        "subscribers": {
          "type": "number"
        },
        "avgViews": {
          "type": "number"
        },
        "engagementRate": {
          "type": "number"
        },
        "rateDedicated": {
          "type": "number"
        },
        "rateIntegrated": {
          "type": "number"
        },
        "rateShorts": {
          "type": "number"
        },
        "credibilityScore": {
          "type": "number"
