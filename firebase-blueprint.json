  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Owner-only private authentication profile, email PII, and portal role."
    },
    "/dealers/{dealerId}": {
      "schema": { "$ref": "#/entities/DealerProfile" },
      "description": "Public brand profiles created by signed-in Business Dealers."
    },
    "/creators/{creatorId}": {
      "schema": { "$ref": "#/entities/CreatorProfileDoc" },
      "description": "Public creator channel profiles and audited engagement metrics."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/ProductCampaignDoc" },
      "description": "Product launch campaigns owned by Business Dealers."
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/DealContractDoc" },
      "description": "Digital sponsorship escrow agreements shared between a dealer and creator."
    },
    "/connections/{connectionId}": {
      "schema": { "$ref": "#/entities/ConnectionLogDoc" },
      "description": "Connection threads between dealers and creators."
    },
    "/connections/{connectionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConnectionMessageDoc" },
      "description": "Subcollection of chat messages within a connection thread."
    }
  }
}
