{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user account metadata and active portal role (PII isolated to owner).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["business", "creator"]
        },
        "dealerProfileId": {
          "type": "string",
          "maxLength": 128
        },
        "creatorProfileId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "photoURL", "role", "createdAt", "updatedAt"]
    },
    "DealerProfile": {
      "title": "DealerProfile",
      "description": "Public brand profile for a signed-in Business Dealer.",
