        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "industry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "website": {
          "type": "string",
          "maxLength": 300
        },
        "tagline": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "avatar": {
          "type": "string",
          "maxLength": 500
        },
        "defaultBudget": {
          "type": "number"
        },
        "targetAgeRange": {
          "type": "string",
          "maxLength": 40
        },
        "primaryRegion": {
          "type": "string",
          "maxLength": 80
        },
        "brandValues": {
          "type": "array"
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "companyName",
        "industry",
        "website",
        "tagline",
        "description",
        "avatar",
        "defaultBudget",
        "targetAgeRange",
        "primaryRegion",
        "brandValues",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreatorProfileDoc": {
      "title": "CreatorProfileDoc",
